# ---- Backend (copy to .env, never commit .env) ----
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
# Optional - Aura's downloaded credentials file includes this line; paste it if present
# NEO4J_DATABASE=neo4j

# Protects /model/train, /model/reload and /cache/clear. Leave unset to disable them.
# ADMIN_TOKEN=a-long-random-string

# Requests per minute per IP for expensive endpoints (0 disables)
# RATE_LIMIT_PER_MIN=60

# Comma-separated frontend origins allowed by CORS (production)
CORS_ORIGINS=http://localhost:3000

# ---- Frontend (set in your static host's build env vars) ----
# VITE_API_URL=https://your-backend.onrender.com
